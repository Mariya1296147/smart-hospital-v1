<jasperReport name="payment_receipt" language="java" pageWidth="595" pageHeight="842"
              columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="hospitalName" class="java.lang.String"/>
    <parameter name="patientName" class="java.lang.String"/>
    <parameter name="patientId" class="java.lang.String"/>
    <parameter name="patientPhone" class="java.lang.String"/>
    <parameter name="doctorName" class="java.lang.String"/>
    <parameter name="departmentName" class="java.lang.String"/>
    <parameter name="appointmentId" class="java.lang.String"/>
    <parameter name="receiptNumber" class="java.lang.String"/>
    <parameter name="invoiceId" class="java.lang.String"/>
    <parameter name="paymentDate" class="java.lang.String"/>
    <parameter name="paymentMethod" class="java.lang.String"/>
    <parameter name="reference" class="java.lang.String"/>
    <parameter name="notes" class="java.lang.String"/>
    <parameter name="invoiceTotal" class="java.math.BigDecimal"/>
    <parameter name="paymentAmount" class="java.math.BigDecimal"/>
    <parameter name="paidToDate" class="java.math.BigDecimal"/>
    <parameter name="balanceDue" class="java.math.BigDecimal"/>
    <parameter name="paymentStatus" class="java.lang.String"/>
    <background height="772">
        <element kind="rectangle" x="0" y="0" width="515" height="772" mode="Opaque" backcolor="#EEF4FA"><pen lineWidth="0.0" lineColor="#EEF4FA"/></element>
    </background>
    <title height="151">
        <element kind="rectangle" x="0" y="0" width="515" height="91" mode="Opaque" backcolor="#102D46" radius="5"><pen lineWidth="0.0" lineColor="#102D46"/></element>
        <element kind="rectangle" x="0" y="87" width="515" height="4" mode="Opaque" backcolor="#22B4AE"><pen lineWidth="0.0" lineColor="#22B4AE"/></element>
        <element kind="textField" x="20" y="17" width="300" height="28" fontName="SansSerif" fontSize="20.0" bold="true" forecolor="#FFFFFF"><expression><![CDATA[$P{hospitalName}]]></expression></element>
        <element kind="staticText" x="20" y="52" width="300" height="15" fontName="SansSerif" fontSize="8.0" bold="true" forecolor="#C8D8E4"><text><![CDATA[HOSPITAL BILLING AND PATIENT ACCOUNTS]]></text></element>
        <element kind="line" x="340" y="17" width="1" height="54" forecolor="#486277"/>
        <element kind="staticText" x="358" y="17" width="137" height="18" fontName="SansSerif" fontSize="8.0" bold="true" forecolor="#93ACBC" hTextAlign="Right"><text><![CDATA[PAYMENT RECEIPT]]></text></element>
        <element kind="textField" x="358" y="39" width="137" height="17" fontName="SansSerif" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right"><expression><![CDATA[$P{receiptNumber}]]></expression></element>
        <element kind="textField" x="358" y="59" width="137" height="14" fontName="SansSerif" fontSize="8.5" forecolor="#C8D8E4" hTextAlign="Right"><expression><![CDATA[$P{paymentDate}]]></expression></element>

        <element kind="rectangle" x="0" y="106" width="515" height="38" mode="Opaque" backcolor="#FFFFFF" radius="4"><pen lineWidth="0.7" lineColor="#D8E2EC"/></element>
        <element kind="staticText" x="14" y="112" width="100" height="11" fontName="SansSerif" fontSize="7.0" bold="true" forecolor="#708596"><text><![CDATA[RECEIVED FROM]]></text></element>
        <element kind="textField" x="14" y="125" width="245" height="15" fontName="SansSerif" fontSize="9.5" bold="true" forecolor="#18364D"><expression><![CDATA[$P{patientName} + "   |   " + $P{patientId}]]></expression></element>
        <element kind="textField" x="275" y="122" width="220" height="15" fontName="SansSerif" fontSize="8.0" forecolor="#526D7E" hTextAlign="Right">
            <printWhenExpression><![CDATA[$P{patientPhone} != null && !$P{patientPhone}.isEmpty()]]></printWhenExpression><expression><![CDATA["Phone: " + $P{patientPhone}]]></expression>
        </element>
    </title>
    <detail>
        <band height="312" splitType="Stretch">
            <element kind="textField" x="0" y="3" width="247" height="15" fontName="SansSerif" fontSize="8.0" forecolor="#526D7E">
                <printWhenExpression><![CDATA[$P{doctorName} != null && !$P{doctorName}.isEmpty()]]></printWhenExpression><expression><![CDATA["Attending doctor: " + $P{doctorName}]]></expression>
            </element>
            <element kind="textField" x="268" y="3" width="247" height="15" fontName="SansSerif" fontSize="8.0" forecolor="#526D7E" hTextAlign="Right">
                <printWhenExpression><![CDATA[$P{departmentName} != null && !$P{departmentName}.isEmpty()]]></printWhenExpression><expression><![CDATA["Department: " + $P{departmentName}]]></expression>
            </element>
            <element kind="textField" x="0" y="20" width="515" height="13" fontName="SansSerif" fontSize="7.5" forecolor="#708596">
                <printWhenExpression><![CDATA[$P{appointmentId} != null && !$P{appointmentId}.isEmpty()]]></printWhenExpression><expression><![CDATA["Visit reference: " + $P{appointmentId}]]></expression>
            </element>
            <element kind="rectangle" x="0" y="51" width="515" height="172" mode="Opaque" backcolor="#FFFFFF" radius="5"><pen lineWidth="0.8" lineColor="#D8E2EC"/></element>
            <element kind="rectangle" x="0" y="51" width="515" height="42" mode="Opaque" backcolor="#DDE8F2" radius="5"><pen lineWidth="0.0" lineColor="#DDE8F2"/></element>
            <element kind="rectangle" x="0" y="51" width="5" height="42" mode="Opaque" backcolor="#183F5C"><pen lineWidth="0.0" lineColor="#183F5C"/></element>
            <element kind="staticText" x="18" y="64" width="275" height="17" fontName="SansSerif" fontSize="9.0" bold="true" forecolor="#18364D"><text><![CDATA[PAYMENT RECEIVED]]></text></element>
            <element kind="textField" x="300" y="59" width="196" height="27" fontName="SansSerif" fontSize="16.0" bold="true" forecolor="#18364D" pattern="#,##0.00" hTextAlign="Right"><expression><![CDATA[$P{paymentAmount}]]></expression></element>

            <element kind="staticText" x="20" y="111" width="150" height="14" fontName="SansSerif" fontSize="8.0" forecolor="#607787"><text><![CDATA[Invoice reference]]></text></element>
            <element kind="textField" x="190" y="111" width="300" height="14" fontName="SansSerif" fontSize="8.5" bold="true" forecolor="#263F50" hTextAlign="Right"><expression><![CDATA[$P{invoiceId}]]></expression></element>
            <element kind="staticText" x="20" y="133" width="150" height="14" fontName="SansSerif" fontSize="8.0" forecolor="#607787"><text><![CDATA[Payment method]]></text>
                <printWhenExpression><![CDATA[$P{paymentMethod} != null && !$P{paymentMethod}.isEmpty()]]></printWhenExpression>
            </element>
            <element kind="textField" x="190" y="133" width="300" height="14" fontName="SansSerif" fontSize="8.5" forecolor="#263F50" hTextAlign="Right">
                <printWhenExpression><![CDATA[$P{paymentMethod} != null && !$P{paymentMethod}.isEmpty()]]></printWhenExpression><expression><![CDATA[$P{paymentMethod}]]></expression>
            </element>
            <element kind="staticText" x="20" y="155" width="150" height="14" fontName="SansSerif" fontSize="8.0" forecolor="#607787">
                <printWhenExpression><![CDATA[$P{reference} != null && !$P{reference}.isEmpty()]]></printWhenExpression><text><![CDATA[Transaction reference]]></text>
            </element>
            <element kind="textField" x="190" y="155" width="300" height="14" fontName="SansSerif" fontSize="8.5" forecolor="#263F50" hTextAlign="Right">
                <printWhenExpression><![CDATA[$P{reference} != null && !$P{reference}.isEmpty()]]></printWhenExpression><expression><![CDATA[$P{reference}]]></expression>
            </element>
            <element kind="staticText" x="20" y="177" width="150" height="14" fontName="SansSerif" fontSize="8.0" forecolor="#607787"><text><![CDATA[Payment status]]></text></element>
            <element kind="textField" x="190" y="177" width="300" height="14" fontName="SansSerif" fontSize="8.5" bold="true" forecolor="#18364D" hTextAlign="Right"><expression><![CDATA[$P{paymentStatus}]]></expression></element>

            <element kind="rectangle" x="0" y="240" width="515" height="60" mode="Opaque" backcolor="#FFFFFF" radius="4"><pen lineWidth="0.7" lineColor="#D8E2EC"/></element>
            <element kind="staticText" x="15" y="248" width="160" height="14" fontName="SansSerif" fontSize="7.5" forecolor="#607787"><text><![CDATA[INVOICE TOTAL]]></text></element>
            <element kind="textField" x="180" y="248" width="315" height="14" fontName="SansSerif" fontSize="8.5" forecolor="#263F50" pattern="#,##0.00" hTextAlign="Right"><expression><![CDATA[$P{invoiceTotal}]]></expression></element>
            <element kind="staticText" x="15" y="269" width="160" height="14" fontName="SansSerif" fontSize="7.5" forecolor="#607787"><text><![CDATA[PAID TO DATE]]></text></element>
            <element kind="textField" x="180" y="269" width="315" height="14" fontName="SansSerif" fontSize="8.5" forecolor="#263F50" pattern="#,##0.00" hTextAlign="Right"><expression><![CDATA[$P{paidToDate}]]></expression></element>
            <element kind="staticText" x="15" y="288" width="160" height="14" fontName="SansSerif" fontSize="8.0" bold="true" forecolor="#18364D"><text><![CDATA[BALANCE DUE]]></text></element>
            <element kind="textField" x="180" y="288" width="315" height="14" fontName="SansSerif" fontSize="9.0" bold="true" forecolor="#18364D" pattern="#,##0.00" hTextAlign="Right"><expression><![CDATA[$P{balanceDue}]]></expression></element>
        </band>
    </detail>
    <summary height="42">
        <element kind="staticText" x="0" y="8" width="515" height="20" fontName="SansSerif" fontSize="8.0" forecolor="#607787">
            <printWhenExpression><![CDATA[$P{notes} != null && !$P{notes}.isEmpty()]]></printWhenExpression><text><![CDATA[Payment note]]></text>
        </element>
        <element kind="textField" x="0" y="22" width="515" height="18" fontName="SansSerif" fontSize="8.0" forecolor="#263F50" textAdjust="StretchHeight">
            <printWhenExpression><![CDATA[$P{notes} != null && !$P{notes}.isEmpty()]]></printWhenExpression><expression><![CDATA[$P{notes}]]></expression>
        </element>
    </summary>
    <pageFooter height="25">
        <element kind="line" x="0" y="0" width="515" height="1" forecolor="#C6D4E0"/>
        <element kind="staticText" x="0" y="7" width="440" height="12" fontName="SansSerif" fontSize="7.0" forecolor="#607787"><text><![CDATA[Thank you. This receipt confirms the payment shown above.]]></text></element>
        <element kind="textField" x="455" y="7" width="60" height="12" fontName="SansSerif" fontSize="7.0" forecolor="#607787" hTextAlign="Right"><expression><![CDATA["PAGE " + $V{PAGE_NUMBER}]]></expression></element>
    </pageFooter>
</jasperReport>
